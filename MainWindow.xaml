<Window x:Class="NOTM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:NOTM.UI"
        mc:Ignorable="d"
        Title="NOTM - Monitor Guard"
        Height="800" Width="960"
        MinHeight="650" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#121214"
        Foreground="#EDEDED"
        FontFamily="Segoe UI, Inter, Roboto, Arial">

    <Window.Resources>
        <!-- Modern Button Styles -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3F3F46"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#71717A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#202024"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#450A0A"/>
            <Setter Property="BorderBrush" Value="#991B1B"/>
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#7F1D1D"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#EF4444"/>
                                <Setter TargetName="btnBorder" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#064E3B"/>
            <Setter Property="BorderBrush" Value="#047857"/>
            <Setter Property="Foreground" Value="#34D399"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#059669"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#10B981"/>
                                <Setter TargetName="btnBorder" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Windows Display Settings Layout Preview -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Selected Monitor Settings Card -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Lower Section (Logs + System Options) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 0: HEADER ================= -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,14" BorderBrush="#27272A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Brand & Guard State -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="#2563EB" Margin="0,0,14,0">
                        <TextBlock Text="🛡" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NOTM" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,10,0"/>
                            <!-- Guard Status Pill -->
                            <Border Background="{Binding StatusBrush, FallbackValue=#10B981}"
                                    CornerRadius="12"
                                    Padding="10,3"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding StatusText, FallbackValue='GUARD ACTIVE'}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Display Guard • Restricts application usage without detaching monitors"
                                   FontSize="12" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Header Quick Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚡ Relocate Windows"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="OnSweepClicked"
                            Margin="0,0,8,0"
                            ToolTip="Instantly move any off-limits window back to primary display"/>

                    <Button Content="🔄 Refresh Displays"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="OnRefreshClicked"
                            Margin="0,0,12,0"
                            ToolTip="Scan for connected display changes"/>

                    <!-- Guard Master Toggle -->
                    <Border Background="#27272A" CornerRadius="8" Padding="12,6" BorderBrush="#3F3F46" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Guard Status:" FontSize="13" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox IsChecked="{Binding IsGuardActive}"
                                      VerticalAlignment="Center"
                                      Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 1: WINDOWS 11 "SYSTEM > DISPLAY" TOPOLOGY ================= -->
        <Border Grid.Row="1"
                Background="#18181B"
                BorderBrush="#27272A"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18,14"
                Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Section Header -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Displays" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="• Select a display below to configure its role" FontSize="12" Foreground="#71717A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Displays.Count, StringFormat='{}{0} Connected'}"
                               HorizontalAlignment="Right"
                               FontSize="12"
                               Foreground="#A1A1AA"/>
                </Grid>

                <!-- Interactive Display Topology Canvas -->
                <ui:MonitorVisualMap x:Name="MonitorMap"
                                     Grid.Row="1"
                                     Height="150"
                                     DisplaysSource="{Binding Displays}"
                                     SelectedDisplay="{Binding SelectedDisplay, Mode=TwoWay}"
                                     Margin="0,0,0,12"/>

                <!-- Action Row underneath Canvas (Identify Displays Button, exactly like Windows 11 Settings) -->
                <Grid Grid.Row="2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="👁 Identify Displays"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="14,7"
                                Margin="0,0,12,0"
                                Click="OnIdentifyAllClicked"
                                ToolTip="Flash large display numbers onto all connected monitors"/>

                        <TextBlock Text="Numbers shown on screen correspond to the boxes above."
                                   FontSize="12"
                                   Foreground="#71717A"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= 2: SELECTED DISPLAY CONFIGURATION CARD ================= -->
        <Border Grid.Row="2"
                Background="#18181B"
                BorderBrush="{Binding SelectedDisplay.StatusBadgeBackground, FallbackValue=#27272A}"
                BorderThickness="1.5"
                CornerRadius="14"
                Padding="18,14"
                Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Display Title & Specs Header -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Selected Monitor Big Index Badge -->
                    <Border Grid.Column="0"
                            Width="40" Height="40"
                            CornerRadius="20"
                            Background="{Binding SelectedDisplay.StatusBadgeBackground, FallbackValue=#2563EB}"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedDisplay.Index, FallbackValue='1'}"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedDisplay.DisplayTitle, FallbackValue='Select a display'}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,10,0"/>
                            <!-- Status Badge -->
                            <Border Background="{Binding SelectedDisplay.StatusBadgeBackground, FallbackValue=#3F3F46}"
                                    CornerRadius="6"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDisplay.StatusDescription, FallbackValue='ALLOWED'}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedDisplay.Subtitle, FallbackValue=''}"
                                   FontSize="12"
                                   Foreground="#A1A1AA"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Identify Single Display Button -->
                    <Button Grid.Column="2"
                            Content="Identify This Display"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="OnIdentifySelectedClicked"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Option Rows for Selected Display -->
                <Border Grid.Row="1" Background="#202024" BorderBrush="#2C2C32" BorderThickness="1" CornerRadius="10" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Primary Target Option -->
                        <Border Grid.Column="0" Background="#27272A" CornerRadius="8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Primary Target Display" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="All windows redirected from blocked monitors are sent here."
                                               FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Set as Primary"
                                        Style="{StaticResource ActionButtonStyle}"
                                        IsEnabled="{Binding SelectedDisplay.IsTargetPrimary, Converter={x:Static ui:InverseBooleanConverter.Instance}}"
                                        Click="OnSetSelectedAsPrimaryClicked"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Block/Allow Toggle Option -->
                        <Border Grid.Column="2" Background="#27272A" CornerRadius="8" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Block Display (Not in Use)" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="Prevent any window from opening or staying on this screen."
                                               FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{Binding SelectedDisplay.IsExcluded, Converter={x:Static ui:BlockButtonTextConverter.Instance}}"
                                        Style="{Binding SelectedDisplay.IsExcluded, Converter={x:Static ui:BlockButtonStyleConverter.Instance}}"
                                        Click="OnToggleSelectedBlockClicked"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= 3: LOWER SECTION (ACTIVITY FEED & APP OPTIONS) ================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="0.9*"/>
            </Grid.ColumnDefinitions>

            <!-- Activity Log -->
            <Border Grid.Column="0"
                    Background="#18181B"
                    BorderBrush="#27272A"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Window Relocation Feed" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,8,0"/>
                            <Border Background="#2563EB" CornerRadius="10" Padding="8,2">
                                <TextBlock Text="{Binding RelocatedCount, StringFormat='{}{0} Redirected'}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <Button Content="Clear"
                                Style="{StaticResource ActionButtonStyle}"
                                Padding="8,3"
                                FontSize="11"
                                HorizontalAlignment="Right"
                                Click="OnClearLogClicked"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="No windows relocated yet. When an app enters a blocked monitor, it will appear here."
                                       Foreground="#71717A"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       Margin="0,25,0,0"
                                       Visibility="{Binding RelocationLog.Count, Converter={x:Static ui:ZeroCountToVisibilityConverter.Instance}}"/>

                            <ItemsControl ItemsSource="{Binding RelocationLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#202024"
                                                BorderBrush="#2E2E33"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,8"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Top: Process Name & Timestamp -->
                                                <Grid Grid.Row="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="#1D4ED8" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding ProcessName}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding WindowTitle}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#E4E4E7"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="210"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding TimeFormatted}"
                                                               HorizontalAlignment="Right"
                                                               FontSize="11"
                                                               Foreground="#71717A"
                                                               VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Bottom: Source to Target -->
                                                <TextBlock Grid.Row="1"
                                                           FontSize="11"
                                                           Foreground="#A1A1AA"
                                                           Margin="0,4,0,0">
                                                    <Run Text="{Binding SourceMonitor}" Foreground="#F87171" FontWeight="SemiBold"/>
                                                    <Run Text=" ➔ " Foreground="#71717A"/>
                                                    <Run Text="{Binding TargetMonitor}" Foreground="#34D399" FontWeight="SemiBold"/>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Settings & System Integration -->
            <Border Grid.Column="2"
                    Background="#18181B"
                    BorderBrush="#27272A"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Application Settings" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="1">
                        <!-- Start with Windows -->
                        <Border Background="#202024" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <CheckBox Content="Launch at Windows Startup"
                                      IsChecked="{Binding StartWithWindows}"
                                      Foreground="#EDEDED"
                                      FontSize="12"
                                      FontWeight="SemiBold"
                                      Cursor="Hand"/>
                        </Border>

                        <!-- Start Minimized -->
                        <Border Background="#202024" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <CheckBox Content="Start Minimized to System Tray"
                                      IsChecked="{Binding StartMinimized}"
                                      Foreground="#EDEDED"
                                      FontSize="12"
                                      FontWeight="SemiBold"
                                      Cursor="Hand"/>
                        </Border>

                        <!-- Show Relocation Notifications -->
                        <Border Background="#202024" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <CheckBox Content="Show Tray Balloon on Relocate"
                                      IsChecked="{Binding ShowNotifications}"
                                      Foreground="#EDEDED"
                                      FontSize="12"
                                      FontWeight="SemiBold"
                                      Cursor="Hand"/>
                        </Border>
                    </StackPanel>

                    <!-- Notice -->
                    <Border Grid.Row="2" Background="#202024" CornerRadius="8" Padding="12,8">
                        <TextBlock Text="Closing this window minimizes NOTM to your notification area."
                                   FontSize="11"
                                   Foreground="#71717A"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

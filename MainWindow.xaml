<Window x:Class="NOTM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:NOTM.UI"
        mc:Ignorable="d"
        Title="NOTM - Monitor Guard"
        Height="570" Width="890"
        MinHeight="520" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#121215"
        Foreground="#EDEDED"
        FontFamily="Segoe UI, Inter, Roboto, Arial"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Modern Button Styles -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#26262B"/>
            <Setter Property="Foreground" Value="#EDEDED"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3B3B42"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#71717A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E1E22"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#450A0A"/>
            <Setter Property="BorderBrush" Value="#991B1B"/>
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#7F1D1D"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#EF4444"/>
                                <Setter TargetName="btnBorder" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#064E3B"/>
            <Setter Property="BorderBrush" Value="#047857"/>
            <Setter Property="Foreground" Value="#34D399"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#059669"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#10B981"/>
                                <Setter TargetName="btnBorder" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <!-- 0: Minimalist Top Bar (Settings + Master Toggle) -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Windows 11 Display Settings Preview -->
            <RowDefinition Height="*"/>
            <!-- 2: Selected Display Configuration Card -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 0: MINIMALIST TOP BAR ================= -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="0,0,0,12" BorderBrush="#26262B" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Brand & Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#2563EB" Margin="0,0,10,0">
                        <TextBlock Text="🛡" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NOTM" FontSize="19" FontWeight="Bold" Foreground="White" Margin="0,0,8,0"/>
                            <!-- Status Badge -->
                            <Border Background="{Binding StatusBrush, FallbackValue=#10B981}"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="White" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding StatusText, FallbackValue='GUARD ACTIVE'}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Display Guard" FontSize="11" Foreground="#71717A"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Settings & Master Toggle (All in Top Bar as requested) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Start with Windows -->
                    <CheckBox Content="Start with Windows"
                              IsChecked="{Binding StartWithWindows}"
                              Foreground="#A1A1AA"
                              FontSize="12"
                              Margin="0,0,14,0"
                              VerticalAlignment="Center"
                              Cursor="Hand"/>

                    <!-- Start Minimized -->
                    <CheckBox Content="Start Minimized"
                              IsChecked="{Binding StartMinimized}"
                              Foreground="#A1A1AA"
                              FontSize="12"
                              Margin="0,0,14,0"
                              VerticalAlignment="Center"
                              Cursor="Hand"/>

                    <!-- Notifications -->
                    <CheckBox Content="Notifications"
                              IsChecked="{Binding ShowNotifications}"
                              Foreground="#A1A1AA"
                              FontSize="12"
                              Margin="0,0,14,0"
                              VerticalAlignment="Center"
                              Cursor="Hand"/>

                    <!-- Sweep Button -->
                    <Button Content="⚡ Sweep"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="OnSweepClicked"
                            Padding="10,5"
                            Margin="0,0,12,0"
                            ToolTip="Instantly move any off-limits window back to primary display"/>

                    <!-- Guard Master Toggle -->
                    <Border Background="#202024" CornerRadius="8" Padding="10,5" BorderBrush="#333338" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Guard:" FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox IsChecked="{Binding IsGuardActive}"
                                      VerticalAlignment="Center"
                                      Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 1: WINDOWS 11 "SYSTEM > DISPLAY" TOPOLOGY ================= -->
        <Border Grid.Row="1"
                Background="#18181C"
                BorderBrush="#26262B"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,12"
                Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Displays" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="• Select a display below to configure its role" FontSize="12" Foreground="#71717A" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Interactive Display Topology Canvas -->
                <ui:MonitorVisualMap x:Name="MonitorMap"
                                     Grid.Row="1"
                                     MinHeight="180"
                                     DisplaysSource="{Binding Displays}"
                                     SelectedDisplay="{Binding SelectedDisplay, Mode=TwoWay}"
                                     Margin="0,0,0,10"/>

                <!-- Action Row underneath Canvas -->
                <Grid Grid.Row="2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="👁 Identify Displays"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="12,6"
                                Margin="0,0,12,0"
                                Click="OnIdentifyAllClicked"
                                ToolTip="Flash large display numbers onto all connected monitors"/>

                        <TextBlock Text="Numbers shown on screen correspond to the display boxes above."
                                   FontSize="11.5"
                                   Foreground="#71717A"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= 2: SELECTED DISPLAY CONFIGURATION CARD ================= -->
        <Border Grid.Row="2"
                Background="#18181C"
                BorderBrush="{Binding SelectedDisplay.StatusBadgeBackground, FallbackValue=#26262B}"
                BorderThickness="1.5"
                CornerRadius="12"
                Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Display Title & Specs Header -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Selected Monitor Index Badge -->
                    <Border Grid.Column="0"
                            Width="32" Height="32"
                            CornerRadius="8"
                            Background="{Binding SelectedDisplay.StatusBadgeBackground, FallbackValue=#2563EB}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedDisplay.Index, FallbackValue='1'}"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedDisplay.DisplayTitle, FallbackValue='Select a display'}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,10,0"/>
                            <!-- Status Badge -->
                            <Border Background="{Binding SelectedDisplay.StatusBadgeBackground, FallbackValue=#3F3F46}"
                                    CornerRadius="6"
                                    Padding="7,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedDisplay.StatusDescription, FallbackValue='ALLOWED'}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedDisplay.Subtitle, FallbackValue=''}"
                                   FontSize="11.5"
                                   Foreground="#A1A1AA"
                                   Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Identify Single Display Button -->
                    <Button Grid.Column="2"
                            Content="Identify This Screen"
                            Style="{StaticResource ActionButtonStyle}"
                            Padding="10,5"
                            FontSize="12"
                            Click="OnIdentifySelectedClicked"
                            VerticalAlignment="Center"/>
                </Grid>

                <!-- Option Rows for Selected Display -->
                <Border Grid.Row="1" Background="#202024" BorderBrush="#2A2A30" BorderThickness="1" CornerRadius="9" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Primary Target Option -->
                        <Border Grid.Column="0" Background="#26262B" CornerRadius="8" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Primary Target Display" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="All windows from blocked monitors will be redirected here."
                                               FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Set as Primary"
                                        Style="{StaticResource ActionButtonStyle}"
                                        IsEnabled="{Binding SelectedDisplay.IsTargetPrimary, Converter={x:Static ui:InverseBooleanConverter.Instance}}"
                                        Click="OnSetSelectedAsPrimaryClicked"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Block/Allow Toggle Option -->
                        <Border Grid.Column="2" Background="#26262B" CornerRadius="8" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Block Display (Not in Use)" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="Prevent any application from using this screen (audio remains active)."
                                               FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{Binding SelectedDisplay.IsExcluded, Converter={x:Static ui:BlockButtonTextConverter.Instance}}"
                                        Style="{Binding SelectedDisplay.IsExcluded, Converter={x:Static ui:BlockButtonStyleConverter.Instance}}"
                                        Click="OnToggleSelectedBlockClicked"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
